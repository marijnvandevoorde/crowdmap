# Database configuration
# DB_TYPE is 'sqlite' or 'mysql'; without it, MySQL is used when MYSQL_HOST is set.
DB_TYPE=sqlite
DB_PATH=database/crowdmap.sqlite

# MySQL (production: MySQL HeatWave, TLS required)
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=crowdmap
# MYSQL_USER=crowdmap
# MYSQL_PASSWORD=
# MYSQL_SSL_MODE=REQUIRED   # DISABLED, REQUIRED or VERIFY_CA (with MYSQL_SSL_CA)

# Application URL (used for QR codes and share links)
APP_URL=http://localhost:8080

# Show error details and stack traces in API responses (local development only)
APP_DEBUG=false
