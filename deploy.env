# sv-deploy config: ships origin/main to the cluster sv-oke (crowdmap.small-victories.co).
# See ../Oracle/deploy/README.md. Run: scripts/deploy.sh (or scripts/deploy.sh --check).
APP=crowdmap
# name|build context|Dockerfile (relative to the context)|extra buildx args
IMAGES='
crowdmap-php|.|Dockerfile|
crowdmap-nginx|frontend|Dockerfile|
'
TARGETS="apps/crowdmap-php/crowdmap-php=crowdmap-php apps/crowdmap-nginx/crowdmap-nginx=crowdmap-nginx"
# Off (0 replicas) since 2026-10-16, so nothing answers; set this to
# https://crowdmap.small-victories.co/ once it is switched on again.
SMOKE_URLS=""
MANIFESTS="k8s/apps/tier2/stacks.py"
